# ---------------------------------------------------------------------------
# TaskFlow Pro configuration
#
# Every value here is optional. With an empty .env the app still runs, seeds a
# demo board, and produces dependency suggestions from the built-in offline
# heuristic. Nothing is required to evaluate the project.
# ---------------------------------------------------------------------------

# --- server ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# SQLite file. Must live on a persistent volume in production.
DATABASE_PATH=./data/taskflow.db

# --- AI ---
# consensus  both models in parallel; agreement is surfaced to the reviewer  (default)
# openai     OpenAI only, heuristic as fallback
# gemini     Gemini only, heuristic as fallback
# heuristic  offline only; no network, no key, fully deterministic
# mock       fixture-driven; used by the test suite
AI_MODE=consensus

# Leave blank to run without that provider. A value still starting with
# "your-" is treated as absent, so a half-filled .env degrades safely instead
# of sending a placeholder to the vendor.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AI_TIMEOUT_MS=15000

# --- admin ---
# Required by POST /api/admin/reset-demo. When unset, that route is disabled
# entirely in production rather than left open.
ADMIN_TOKEN=

# --- limits ---
MAX_BODY_BYTES=262144
